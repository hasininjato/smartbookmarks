{
  "name": "smartbookmarks",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.1",
  "license": "MIT",
  "l10n": "./l10n",
  "publisher": "rojovao",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hasininjato/smartbookmarks"
  },
  "bugs": {
    "url": "https://github.com/hasininjato/smartbookmarks/issues"
  },
  "homepage": "https://github.com/hasininjato/smartbookmarks#readme",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartBookmarksContainer",
          "title": "%viewsContainers.smartBookmarksContainer%",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "smartBookmarksContainer": [
        {
          "id": "smartBookmarksView",
          "name": "%views.smartBookmarksView%",
          "icon": "$(bookmark)"
        }
      ]
    },
    "commands": [
      {
        "command": "smartbookmarks.addBookmark",
        "title": "%command.addBookmark%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.nextBookmark",
        "title": "%command.nextBookmark%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.previousBookmark",
        "title": "%command.previousBookmark%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.listBookmarks",
        "title": "%command.listBookmarks%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.clearAllBookmarks",
        "title": "%command.clearAllBookmarks%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.clearFileBookmarks",
        "title": "%command.clearFileBookmarks%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.deleteSingleBookmark",
        "title": "%command.deleteSingleBookmark%",
        "icon": "$(trash)"
      },
      {
        "command": "smartbookmarks.deleteFileBookmarksFromTree",
        "title": "%command.deleteFileBookmarksFromTree%",
        "icon": "$(trash)"
      },
      {
        "command": "smartbookmarks.addBookmarkWithComment",
        "title": "%command.addBookmarkWithComment%",
        "category": "Smart Bookmarks"
      },
      {
        "command": "smartbookmarks.renameBookmark",
        "title": "%command.renameBookmark%",
        "category": "Smart Bookmarks",
        "icon": "$(edit)"
      }
    ],
    "keybindings": [
      {
        "command": "smartbookmarks.addBookmark",
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m"
      },
      {
        "command": "smartbookmarks.nextBookmark",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "smartbookmarks.previousBookmark",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "smartbookmarks.clearFileBookmarks",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c"
      },
      {
        "command": "smartbookmarks.clearAllBookmarks",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "smartbookmarks.addBookmarkWithComment",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "smartbookmarks.renameBookmark",
        "key": "f2",
        "when": "focusedView == smartBookmarksView"
      }
    ],
    "configuration": {
      "title": "Smart Bookmarks",
      "properties": {
        "smartbookmarks.persistBookmarks": {
          "type": "boolean",
          "default": true,
          "description": "%config.persistBookmarks%"
        },
        "smartbookmarks.autoFollowSymbols": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoFollowSymbols%"
        },
        "smartbookmarks.tags": {
          "type": "array",
          "description": "%config.tags.description%",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "%config.tags.label.description%"
              },
              "icon": {
                "type": "string",
                "description": "%config.tags.icon.description%"
              },
              "description": {
                "type": "string",
                "description": "%config.tags.itemDescription.description%"
              }
            },
            "required": [
              "label"
            ]
          },
          "default": [
            {
              "label": "NOTE",
              "icon": "notebook",
              "description": "Remarque ou note d'information"
            },
            {
              "label": "FIXME",
              "icon": "tools",
              "description": "Code à corriger ou refactoriser"
            },
            {
              "label": "TODO",
              "icon": "checklist",
              "description": "Tâche restant à faire"
            },
            {
              "label": "BUG",
              "icon": "bug",
              "description": "Problème ou dysfonctionnement"
            },
            {
              "label": "REVIEW",
              "icon": "eye",
              "description": "Nécessite une revue de code"
            }
          ]
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "smartbookmarks.deleteSingleBookmark",
          "when": "viewItem == bookmarkItem",
          "group": "inline"
        },
        {
          "command": "smartbookmarks.deleteFileBookmarksFromTree",
          "when": "viewItem == fileItem",
          "group": "inline"
        },
        {
          "command": "smartbookmarks.renameBookmark",
          "when": "view == smartBookmarksView && viewItem == bookmarkItem",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "web-tree-sitter": "^0.20.8"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.4"
  }
}
